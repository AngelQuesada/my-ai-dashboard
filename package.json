{
  "name": "my-ai-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development next dev",
    "dev:test": "cross-env NODE_ENV=testing next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:e2e:run": "playwright test",
    "test:e2e": "start-server-and-test 'pnpm dev:test' http://localhost:3001 'pnpm test:e2e:run'",
    "test:unit:ci": "jest --ci",
    "test:e2e:ci": "start-server-and-test 'pnpm dev:test' http://localhost:3001 'pnpm test:e2e:run'",
    "test:ci": "pnpm test:unit:ci && pnpm test:e2e:ci"
  },
  "dependencies": {
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@fontsource/roboto": "^5.2.8",
    "@google/generative-ai": "^0.24.1",
    "@mui/material": "^5.0.0",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.78.0",
    "next": "14.2.3",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@emotion/server": "^11.11.0",
    "@mui/icons-material": "^5.0.0",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.3",
    "eslint": "^8",
    "eslint-config-next": "14.2.3",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "next-router-mock": "^1.0.4",
    "playwright": "^1.56.1",
    "start-server-and-test": "^2.0.5",
    "ts-jest": "^29.4.5",
    "typescript": "^5"
  }
}
